{
  "name": "jiuji-barmap",
  "version": "0.3.0",
  "private": true,
  "description": "React TypeScript four-platform bar discovery project",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "data:sync": "node scripts/sync-react-bars.cjs && node scripts/export-sites-seed.cjs",
    "data:check": "node scripts/sync-react-bars.cjs --check",
    "contracts:check": "node scripts/verify-contracts.cjs",
    "compat:check": "node scripts/verify-compat.cjs",
    "syntax:check": "node scripts/check-syntax.cjs",
    "check": "npm run data:check && npm run sites:check && npm run sites:exports:check && npm run sync:check && npm run contracts:check && npm run compat:check && npm run syntax:check && npm test",
    "migration:status": "node scripts/migration-status.cjs",
    "sites:seed": "node scripts/export-sites-seed.cjs",
    "sites:check": "node scripts/export-sites-seed.cjs --check",
    "sites:import": "node scripts/import-sites-export.cjs",
    "sites:exports:check": "node scripts/import-sites-export.cjs --check",
    "sync:generate": "node scripts/generate-sync-core.cjs",
    "sync:check": "node scripts/generate-sync-core.cjs --check",
    "sites:probe": "node scripts/probe-sites-api.cjs",
    "test:journal": "node --experimental-strip-types --test tests/private-journal.test.mjs",
    "test:quick-ui": "node --experimental-strip-types --test tests/quick-journal-ui.test.mjs",
    "test:journal-views": "node --experimental-strip-types --test tests/personal-journal-views.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/wechat-auth.test.mjs",
    "test:backend": "node --test --experimental-sqlite apps/private-api/tests/*.test.mjs"
  }
}
