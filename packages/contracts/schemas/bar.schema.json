{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiuji.dev/schemas/bar.v1.json",
  "title": "Jiuji Bar v1 (seed record)",
  "type": "object",
  "required": ["id", "name", "station", "lines", "status", "rating", "location"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "searchKey": { "type": "string" },
    "station": { "type": "string" },
    "exit": { "type": "string" },
    "lines": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": { "enum": ["official", "listed", "unknown", "closed"] },
    "statusCheckedAt": { "type": "string" },
    "rating": {
      "type": ["object", "null"],
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "price": { "type": ["number", "null"], "minimum": 0 },
        "reviews": { "type": "integer", "minimum": 0 },
        "platform": { "type": "string" },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    },
    "addressHint": { "type": "string" },
    "location": {
      "type": ["object", "null"],
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
