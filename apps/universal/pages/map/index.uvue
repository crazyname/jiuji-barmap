<template>
  <view class="page">
    <view class="toolbar">
      <text class="overline">JIUJI / BAR MAP</text>
      <text class="headline">城市酒吧地图</text>
      <input class="search" v-model="keyword" placeholder="搜索酒吧、商圈或站点" />
      <view class="filters">
        <text class="filter" :class="status == 'all' ? 'active' : ''" @click="status = 'all'">全部</text>
        <text class="filter" :class="status == 'official' ? 'active' : ''" @click="status = 'official'">官网资料</text>
        <text class="filter" :class="status == 'listed' ? 'active' : ''" @click="status = 'listed'">平台记录</text>
        <text class="filter" :class="status == 'unknown' ? 'active' : ''" @click="status = 'unknown'">待核实</text>
      </view>
    </view>
    <map id="jiujiMap" class="map" :latitude="centerLat" :longitude="centerLng" :scale="scale"
       :markers="markers" :enable-scroll="true" :enable-zoom="true" :enable-poi="true"
       @markertap="markerTap"></map>
    <view class="statusbar"><text>广州 · {{displayed.length}} 家记录 · 已定位 {{markers.length}} 家</text></view>
    <view v-if="selectedId != 0" class="selectbar">
      <text class="selecttext">{{selectedName}}</text>
      <button size="mini" class="outline" @click="choosePoint">确认地图位置</button>
      <button size="mini" class="primary" @click="navigate">导航</button>
    </view>
    <scroll-view scroll-y="true" class="list">
      <view class="place" v-for="bar in displayed" :key="bar.id" @click="selectBar(bar.id)">
        <view class="no"><text>{{bar.id}}</text></view>
        <view class="placeinfo">
          <text class="name">{{bar.name}}</text>
          <text class="sub">{{bar.station}} · {{statusName(bar.status)}} · {{getPrice(bar)}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </scroll-view>
    <view class="disclaimer"><text>仅定位已人工确认的坐标；经营资料不代表此刻开门。</text></view>
  </view>
</template>
<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import seed from '../../data/bars.json'
import { getLocalLocations, setLocalLocation } from '../../utils/local'

type Bar = { id: number, name: string, station: string, status: string, rating: { price: number | null, score: number | null } | null }
const bars = seed as Bar[]
const keyword = ref('')
const status = ref('all')
const centerLat = ref(23.12908)
const centerLng = ref(113.26436)
const scale = ref(12)
const selectedId = ref(0)
const positions = ref(getLocalLocations())
const displayed = computed(() => bars.filter(b => (status.value == 'all' || b.status == status.value) &&
  (keyword.value == '' || (b.name + b.station).toLowerCase().includes(keyword.value.toLowerCase()))))
const markers = computed(() => displayed.value.filter(b => positions.value[String(b.id)] != null).map(b => {
  const point = positions.value[String(b.id)]!
  return { id: b.id, title: b.name, latitude: point.latitude, longitude: point.longitude,
    iconPath: '/static/pin.png', width: 28, height: 28 }
}))
const selectedName = computed(() => bars.find(b => b.id == selectedId.value)?.name || '')
function statusName(s: string): string {
  if(s == 'official') return '官网有资料'
  if(s == 'listed') return '平台有记录'
  if(s == 'closed') return '停业提示'
  return '经营待核实'
}
function getPrice(b: Bar): string { return b.rating?.price != null ? '参考人均 ¥' + b.rating.price : '人均待核实' }
function selectBar(id: number): void {
  selectedId.value = id
  const p = positions.value[String(id)]
  if (p != null) { centerLat.value = p.latitude; centerLng.value = p.longitude; scale.value = 15 }
}
function markerTap(e: UniMapMarkerTapEvent): void { selectBar(e.detail.markerId) }
function choosePoint(): void {
  if (selectedId.value == 0) return
  uni.chooseLocation({success: p => {
    if(p.latitude < 22.5 || p.latitude > 23.9 || p.longitude < 112.5 || p.longitude > 114.2) {
      uni.showToast({title:'请在广州区域选择地点', icon:'none'}); return
    }
    setLocalLocation(selectedId.value, {latitude:p.latitude, longitude:p.longitude, address:p.address || ''})
    positions.value = getLocalLocations()
    selectBar(selectedId.value)
  }})
}
function navigate(): void {
  const p = positions.value[String(selectedId.value)]
  if (p == null) { uni.showToast({title:'请先确认坐标', icon:'none'}); return }
  uni.openLocation({latitude:p.latitude, longitude:p.longitude, name:selectedName.value, address:p.address})
}
onShow(() => { positions.value = getLocalLocations() })
</script>
<style>
.page{flex:1;background-color:#f4eddf}
.toolbar{background-color:#f9f4eb;padding:12px 15px 11px}
.overline{font-size:9px;letter-spacing:2px;color:#82442f}
.headline{font-size:23px;font-weight:700;color:#35291f;margin-top:5px;margin-bottom:10px}
.search{height:40px;background:#f4eddf;border:1px solid #d8c7b5;padding:0 12px;border-radius:5px;font-size:13px}
.filters{display:flex;flex-direction:row;margin-top:9px;gap:7px}
.filter{font-size:11px;color:#675546;background:#ede1d2;padding:7px;border-radius:5px}
.filter.active{background:#82442f;color:#fff}
.map{width:100%;height:285px}
.statusbar{padding:11px 15px 4px;font-size:11px;color:#887969}
.selectbar{display:flex;flex-direction:row;align-items:center;padding:5px 11px;gap:5px;background:#f9f4eb}
.selecttext{font-size:11px;flex:1;max-width:38%}
.primary{background-color:#82442f;color:white;font-size:11px}
.outline{border:1px solid #82442f;color:#82442f;background:#f9f4eb;font-size:11px}
.list{height:210px}
.place{display:flex;flex-direction:row;align-items:center;padding:12px 16px;border-bottom:1px solid #d8c7b5}
.no{width:28px;height:28px;background:#ede1d2;align-items:center;justify-content:center;margin-right:10px}
.no text{color:#82442f;font-size:11px}
.placeinfo{flex:1}
.name{font-size:13px;color:#35291f;font-weight:700}
.sub{font-size:10px;color:#887969;margin-top:4px}
.arrow{color:#82442f;font-size:19px}
.disclaimer{padding:7px 13px}.disclaimer text{font-size:10px;color:#887969}
</style>
