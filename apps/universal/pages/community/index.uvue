<template>
  <view class="page">
    <text class="kicker">JIUJI / COMMUNITY</text><text class="title">城市酒事</text>
    <text class="desc">探店、品酒和明确标注的商业推广。</text>
    <button class="primary" @click="create">＋ 发布分享</button>
    <scroll-view class="list" scroll-y="true">
      <view v-for="item in items" :key="item.id" class="card">
        <text class="meta">{{item.category}} · {{item.createdAt}}</text>
        <text class="cardTitle">{{item.title}}</text>
        <text class="body">{{item.body}}</text>
        <button size="mini" class="outline" @click="copyForXhs(item)">复制小红书文案＋话题</button>
      </view>
      <view class="empty" v-if="items.length == 0"><text>还没有分享，可以写下第一篇探店记录。</text></view>
    </scroll-view>
    <text class="foot">本机笔记；尚未接入公开社区和审核。小红书笔记需自行发布。</text>
  </view>
</template>
<script setup lang="ts">
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { getJournals, type Journal } from '../../utils/local'
const items = ref<Journal[]>([])
onShow(() => { items.value = getJournals('post') })
function create():void {uni.navigateTo({url:'/pages/compose-post/index'})}
function copyForXhs(item: Journal):void {
 const tag = item.category == '广告推广' ? '\n#广告 #合作推广' : ''
 uni.setClipboardData({data:item.title+'\n'+item.body+'\n#酒迹 #JiujiBarMap'+tag})
}
</script>
<style>
.page{flex:1;padding:22px 18px;background:#f4eddf}.kicker{color:#82442f;font-size:10px;letter-spacing:2px}.title{font-size:28px;color:#35291f;font-weight:700;margin-top:8px}.desc{font-size:12px;color:#887969;margin:8px 0 24px}.primary{background:#82442f;color:#fff;border-radius:5px}.list{height:62vh;margin-top:18px}.card{display:flex;flex-direction:column;border:1px solid #d8c7b5;background:#f9f4eb;padding:15px;margin-bottom:12px}.meta{font-size:10px;color:#82442f}.cardTitle{font-size:18px;font-weight:700;margin:8px 0;color:#35291f}.body{font-size:12px;color:#6a5849;line-height:1.8}.outline{border:1px solid #82442f;background:#f9f4eb;color:#82442f;font-size:11px;margin-top:9px}.empty{padding:35px 10px;align-items:center}.empty text{color:#887969;font-size:12px}.foot{font-size:10px;color:#887969}
</style>
