<template>
  <view class="page">
    <text class="kicker">CREATE / COCKTAIL</text><text class="title">写一份调酒教程</text>
    <text class="label">酒款名称</text><input class="field" v-model="title" maxlength="80" placeholder="例如：Gin & Tonic" />
    <text class="label">材料、用量与步骤</text><textarea class="textarea" v-model="body" maxlength="3000" placeholder="例：金酒 45ml、汤力水 120ml；加冰后轻轻搅拌…" />
    <button class="primary" @click="submit">保存到本机</button>
    <text class="desc">这是本机草稿，不会自动公开发布到其他用户的设备。</text>
  </view>
</template>
<script setup lang="ts">
import { ref } from 'vue'
import { addJournal, getProfile } from '../../utils/local'
const title=ref('');const body=ref('')
function submit():void {
 if(title.value.trim() == '' || body.value.trim() == '') {uni.showToast({title:'请填写名称和步骤',icon:'none'});return}
 addJournal('recipe',{id:Date.now(),title:title.value.trim(),body:body.value.trim(),category:'原创配方',author:getProfile(),createdAt:new Date().toISOString().slice(0,10)})
 uni.navigateBack()
}
</script>
<style>
.page{flex:1;background:#f4eddf;padding:22px}.kicker{font-size:10px;color:#82442f;letter-spacing:2px}.title{font-size:24px;color:#35291f;font-weight:700;margin:8px 0 20px}.label{font-size:12px;color:#887969;margin-top:20px;margin-bottom:8px}.field,.textarea{background:#f9f4eb;border:1px solid #d8c7b5;font-size:13px;color:#35291f;padding:12px;border-radius:5px}.field{height:45px}.textarea{height:190px;width:100%}.primary{background:#82442f;color:#fff;margin-top:24px}.desc{font-size:11px;line-height:1.7;color:#887969;margin-top:15px}
</style>
