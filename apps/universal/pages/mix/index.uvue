<template>
  <view class="page">
    <text class="kicker">JIUJI / RECIPES</text><text class="title">调酒手记</text>
    <text class="desc">记录自己的配方、比例与制作步骤。</text>
    <button class="primary" @click="create">＋ 新建调酒教程</button>
    <scroll-view class="list" scroll-y="true">
      <view v-for="item in items" :key="item.id" class="card">
        <text class="meta">{{item.category}} · {{item.createdAt}}</text>
        <text class="cardTitle">{{item.title}}</text>
        <text class="body">{{item.body}}</text>
      </view>
      <view class="empty" v-if="items.length == 0"><text>还没有教程，先记录你做的第一杯。</text></view>
    </scroll-view>
  </view>
</template>
<script setup lang="ts">
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { getJournals, type Journal } from '../../utils/local'
const items = ref<Journal[]>([])
onShow(() => { items.value = getJournals('recipe') })
function create(): void { uni.navigateTo({url:'/pages/compose-recipe/index'}) }
</script>
