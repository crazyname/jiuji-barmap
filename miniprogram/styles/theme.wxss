/* Jiuji theme skin: central semantic colors. Avoid CSS var() for older WXSS runtimes. */
.jiuji-page { background: #F7F5F5; color: #242329; }
.jiuji-surface { background: #FFFFFF; color: #242329; }
.jiuji-card { background: #FFFFFF; border: 1rpx solid #E6E6E8; border-radius: 20rpx; }
.jiuji-title { color: #242329; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; font-weight: 700; }
.jiuji-muted { color: #6F6D74; }
.jiuji-overline { color: #82442f; font-size: 19rpx; letter-spacing: 0; font-weight: 700; }
.jiuji-rule { border-color: #E6E6E8; }
.jiuji-input { color: #242329; background: #F7F5F5; border: 1rpx solid #E6E6E8; border-radius: 7rpx; }
.jiuji-chip { color: #675546; background: #F7F5F5; border: 1rpx solid #E6E6E8; border-radius: 24rpx; }
.jiuji-chip-active { color: #fff; background: #82442f; border-color: #82442f; }
.jiuji-primary { color: #fff; background: #82442f; border: 1rpx solid #82442f; border-radius: 12rpx; }
.jiuji-secondary { color: #82442f; background: #FFFFFF; border: 1rpx solid #82442f; border-radius: 12rpx; }
.jiuji-panel { background: #F7F5F5; color: #242329; }
.jiuji-accent { color: #82442f; }
.jiuji-notice { color: #795331; background: #f2e6c9; }
/* A is the default; the earlier editorial palette remains available when chosen explicitly. */
.theme-minimal.jiuji-page { background: #f7f5f5; color: #242329; }
.theme-minimal .jiuji-surface,.theme-minimal .jiuji-card { background: #fff; color: #242329; }
.theme-minimal .jiuji-card,.theme-minimal .jiuji-rule { border-color: #E6E6E8; }
.theme-minimal .jiuji-title { font-family: -apple-system, 'PingFang SC', sans-serif; color: #242329; }
.theme-minimal .jiuji-muted { color: #807c83; }
.theme-minimal .jiuji-overline,.theme-minimal .jiuji-accent { color: #82442F; }
.theme-minimal .jiuji-input { color: #242329; background: #f7f5f5; border-color: #E6E6E8; }
.theme-minimal .jiuji-chip { color: #4e454b; background: #F7F5F5; border-color: #E6E6E8; }
.theme-minimal .jiuji-chip-active,.theme-minimal .jiuji-primary { background: #82442F; color: #fff; border-color: #82442F; }
.theme-minimal .jiuji-secondary { color: #82442F; background: #fff; border-color: #82442F; }
.theme-minimal .jiuji-panel { background: #F7F5F5; color: #242329; }
.theme-minimal .jiuji-notice { background: #fff6e5; color: #72552e; }
.theme-noir.jiuji-page { background: #131418; color: #f8f2e9; }
.theme-noir .jiuji-surface,.theme-noir .jiuji-card { background: #222126; color: #f8f2e9; }
.theme-noir .jiuji-card,.theme-noir .jiuji-rule { border-color: #454149; }
.theme-noir .jiuji-title { font-family: -apple-system, 'PingFang SC', sans-serif; color: #f8f2e9; }
.theme-noir .jiuji-muted { color: #c2b8ae; }
.theme-noir .jiuji-overline,.theme-noir .jiuji-accent { color: #e9ba79; }
.theme-noir .jiuji-input { color: #f8f2e9; background: #131418; border-color: #454149; }
.theme-noir .jiuji-chip { color: #eee4dc; background: #353039; border-color: #454149; }
.theme-noir .jiuji-chip-active,.theme-noir .jiuji-primary { background: #e9ba79; color: #171719; border-color: #e9ba79; }
.theme-noir .jiuji-secondary { color: #e9ba79; background: #222126; border-color: #e9ba79; }
.theme-noir .jiuji-panel { background: #353039; color: #f8f2e9; }
.theme-noir .jiuji-notice { color: #e9ba79; background: #393125; }
.theme-pop.jiuji-page { background: #f2f2ff; color: #15204c; }
.theme-pop .jiuji-surface,.theme-pop .jiuji-card { background: #fff; color: #15204c; }
.theme-pop .jiuji-card,.theme-pop .jiuji-rule { border-color: #d5d9f4; }
.theme-pop .jiuji-title { font-family: -apple-system, 'PingFang SC', sans-serif; color: #15204c; }
.theme-pop .jiuji-muted { color: #6c7195; }
.theme-pop .jiuji-overline,.theme-pop .jiuji-accent { color: #3048e8; }
.theme-pop .jiuji-input { color: #15204c; background: #f2f2ff; border-color: #d5d9f4; }
.theme-pop .jiuji-chip { color: #22377a; background: #e6e9ff; border-color: #d5d9f4; }
.theme-pop .jiuji-chip-active,.theme-pop .jiuji-primary { background: #3048e8; color: #fff; border-color: #3048e8; }
.theme-pop .jiuji-secondary { color: #3048e8; background: #fff; border-color: #3048e8; }
.theme-pop .jiuji-panel { background: #e6e9ff; color: #15204c; }
.theme-pop .jiuji-notice { background: #fff4d9; color: #655420; }

/* Preserve explicitly selected C/editorial user preferences without changing default A. */
.theme-editorial.jiuji-page { background:#F4EDDF; color:#35291F; }
.theme-editorial .jiuji-surface,.theme-editorial .jiuji-card { background:#F9F4EB; color:#35291F; }
.theme-editorial .jiuji-card,.theme-editorial .jiuji-rule { border-color:#D8C7B5; }
.theme-editorial .jiuji-title { color:#35291F; font-family:Georgia,'Songti SC','SimSun',serif; }
.theme-editorial .jiuji-muted { color:#887969; }
.theme-editorial .jiuji-input { color:#35291F; background:#F4EDDF; border-color:#D8C7B5; }
.theme-editorial .jiuji-chip { color:#675546; background:#EDE1D2; border-color:#D8C7B5; }
.theme-editorial .jiuji-panel { background:#EDE1D2; color:#35291F; }
.theme-editorial .jiuji-secondary { background:#F9F4EB; }
.theme-editorial .jiuji-notice { color:#795331; background:#F2E6C9; }
