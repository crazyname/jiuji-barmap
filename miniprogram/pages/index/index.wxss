.page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.search-area { position: relative; flex-shrink: 0; padding: 15rpx 22rpx 11rpx; border-bottom: 1rpx solid #E6E6E8; }
.title-row { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-bottom: 13rpx; }
.brand-lockup { display: flex; align-items: center; gap: 13rpx; min-width: 0; }
.brand { font-size: 36rpx; letter-spacing: 0; line-height: 1.15; white-space: nowrap; }
.brand-side { display: flex; flex-direction: column; gap: 4rpx; }
.brand-side .jiuji-overline { font-size: 16rpx; }
.tagline { font-size: 17rpx; letter-spacing: 1rpx; }
.city-label { font-size: 17rpx; font-weight: 700; flex-shrink: 0; }
.search-row { display: flex; gap: 10rpx; margin-bottom: 12rpx; align-items: stretch; }
.search-field { display: flex; align-items: center; flex: 1; min-width: 0; height: 76rpx; padding: 0 16rpx; }
.search-icon { color: #82442f; font-size: 37rpx; margin-right: 8rpx; }
.search { flex: 1; min-width: 0; height: 73rpx; font-size: 24rpx; }
.placeholder { color: #6F6D74; }
.add { margin: 0; padding: 0 20rpx; min-width: 121rpx; height: 78rpx; line-height: 76rpx; font-size: 22rpx; font-weight: 700; }
.add::after { border: 0; }
.filter-row { display: flex; gap: 8rpx; margin-bottom: 12rpx; }
.picker { flex: 1; min-width: 0; height: 62rpx; line-height: 60rpx; padding: 0 5rpx; box-sizing: border-box; font-size: 20rpx; text-align: center; }
.line-scroll { white-space: nowrap; width: 100%; }
.line-flex { display: flex; flex-direction: row; gap: 9rpx; width: max-content; }
.line-item { display: flex; align-items: center; flex-shrink: 0; padding: 9rpx 15rpx; font-size: 20rpx; }
.line-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 7rpx; }
.map-wrap { position: relative; flex: 1 1 auto; min-height: 255rpx; overflow: hidden; }
.real-map { width: 100%; height: 100%; }
/* cover-view is intentionally limited to supported typography and simple blocks. */
.map-note { position: absolute; top: 13rpx; left: 16rpx; padding: 10rpx 13rpx; border-radius: 6rpx; background: rgba(255,255,255,.96); color: #6F6D74; font-size: 19rpx; }
.floating-card { box-shadow: 0 4rpx 20rpx rgba(20,20,25,.08); position: absolute; bottom: 16rpx; left: 17rpx; right: 17rpx; padding: 16rpx 19rpx 14rpx; background: #FFFFFF; border: 1rpx solid #E6E6E8; border-top: 1rpx solid #E6E6E8; border-radius: 9rpx; }
.floating-overline { color: #82442f; font-size: 17rpx; letter-spacing: 2rpx; margin-bottom: 6rpx; }
.floating-name { font-size: 30rpx; font-weight: 750; color: #242329; margin-bottom: 8rpx; }
.floating-secondary { color: #6F6D74; font-size: 20rpx; margin-bottom: 5rpx; }
.floating-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; padding-top: 8rpx; border-top: 1rpx solid #E6E6E8; }
.floating-location { font-size: 18rpx; color: #6F6D74; }
.detail-button { padding: 9rpx 13rpx; background: #82442f; color: #fff; border-radius: 6rpx; font-size: 20rpx; }
.results { flex-shrink: 0; display: flex; flex-direction: column; overflow: hidden; }
.results.expanded { height: 29vh; min-height: 270rpx; }
.results.collapsed { height: 121rpx; }
.result-title { padding: 14rpx 23rpx 12rpx; border-bottom: 1rpx solid #E6E6E8; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.result-title>view { display: flex; flex-direction: column; gap: 6rpx; }
.result-kicker { font-size: 15rpx; }
.result-count { font-size: 23rpx; font-weight: 750; }
.result-count .jiuji-muted { font-weight: 400; font-size: 20rpx; }
.toggle,.refresh { font-size: 20rpx; flex-shrink: 0; }
.hint { padding: 9rpx 20rpx; font-size: 19rpx; line-height: 1.5; }
.bar-scroll { min-height: 0; flex: 1; }
.bar-row { display: flex; align-items: center; padding: 16rpx 22rpx; gap: 13rpx; border-bottom: 1rpx solid #E6E6E8; }
.bar-id { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 5rpx; font-size: 20rpx; font-weight: 750; flex-shrink: 0; }
.bar-text { display: flex; flex-direction: column; min-width: 0; flex: 1; gap: 5rpx; }
.bar-name { font-size: 24rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-sub { font-size: 19rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.rating { font-weight: 750; }
.chev { font-size: 35rpx; }
.empty { padding: 38rpx; text-align: center; font-size: 22rpx; }
.compact-actions { padding: 7rpx 23rpx 11rpx; text-align: right; }
.theme-noir .search-area { border-color: #454149; }
.theme-noir .map-note { background: #222126; color: #f8f2e9; }
.theme-noir .floating-card { background: #222126; border-color: #454149; border-top-color: #e9ba79; }
.theme-noir .floating-name { color: #f8f2e9; }
.theme-noir .floating-overline { color: #e9ba79; }
.theme-noir .floating-secondary,.theme-noir .floating-location { color: #c2b8ae; }
.theme-noir .detail-button { color: #171719; background: #e9ba79; }
.theme-noir .search-icon { color: #e9ba79; }
.theme-noir .placeholder { color: #b2a9a3; }
.theme-minimal .floating-card { background: #fff; border-color: #E6E6E8; border-top-color: #E6E6E8; }
.theme-minimal .floating-overline { color: #82442F; }
.theme-minimal .floating-name { color: #242329; }
.theme-minimal .detail-button { background: #82442F; }
.theme-pop .floating-card { background: #fff; border-color: #d5d9f4; border-top-color: #3048e8; }
.theme-pop .floating-overline { color: #3048e8; }
.theme-pop .floating-name { color: #15204c; }
.theme-pop .detail-button { background: #3048e8; }

.theme-editorial .search-area,.theme-editorial .bar-row,.theme-editorial .result-title {border-color:#D8C7B5;}
.theme-editorial .floating-card {background:#F9F4EB;border-color:#BFA68D;border-top-color:#82442F;}
.theme-editorial .floating-name {color:#35291F;}
.theme-editorial .map-note {background:rgba(249,244,235,.95);color:#715F4E;}
