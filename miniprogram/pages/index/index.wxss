.page { height: 100vh; display: flex; flex-direction: column; background: #faf9fa; }
.search-area { background: #fff; padding: 20rpx 22rpx 12rpx; flex-shrink: 0; }
.title-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14rpx; }
.title { font-size: 36rpx; font-weight: 800; }
.tiny { color: #9b9299; font-size: 20rpx; letter-spacing: 1rpx; }
.search-row { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.search { flex: 1; border: 1rpx solid #e4dfe2; background: #f8f7f7; border-radius: 12rpx; padding: 13rpx 18rpx; height: 56rpx; font-size: 26rpx; }
.add { flex-shrink: 0; margin: 0; background: #912b58; color: white; font-size: 23rpx; line-height: 82rpx; height: 82rpx; border-radius: 12rpx; padding: 0 22rpx; }
.line-scroll { white-space: nowrap; width: 100%; margin: 6rpx 0 15rpx; }
.line-flex { display: flex; flex-direction: row; gap: 12rpx; width: max-content; }
.line-item { border: 1rpx solid #ebe4e8; color: #655d63; border-radius: 38rpx; padding: 11rpx 19rpx; background: #f9f8f9; font-size: 22rpx; display: flex; align-items: center; }
.line-item.current { border-color: #952858; color: #922958; background: #fff2f7; font-weight: 700; }
.line-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 9rpx; }
.filter-row { display: flex; gap: 10rpx; }
.picker { flex: 1; min-width: 0; text-align: center; font-size: 21rpx; border: 1rpx solid #eee8ec; border-radius: 9rpx; padding: 12rpx 2rpx; }
.map-wrap { flex: 1 1 auto; min-height: 350rpx; position: relative; }
.real-map { width: 100%; height: 100%; }
.map-note { position: absolute; top: 15rpx; left: 16rpx; background: rgba(255,255,255,.92); color: #786e75; border-radius: 8rpx; font-size: 20rpx; padding: 9rpx 14rpx; pointer-events: none; }
.floating-card { position: absolute; left: 17rpx; right: 17rpx; bottom: 18rpx; padding: 15rpx 19rpx; background: rgba(255,255,255,.98); border-radius: 15rpx; display: flex; align-items: center; gap: 10rpx; box-shadow: 0 4rpx 18rpx #22222221; }
.floating-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.floating-name { font-weight: 700; font-size: 26rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.floating-secondary { font-size: 20rpx; color: #77717a; }
.detail-button { margin: 0; background: #922958; color: white; font-size: 22rpx; flex-shrink: 0; padding: 15rpx 20rpx; border-radius: 9rpx; }
.results { height: 32vh; min-height: 280rpx; background: white; display: flex; flex-direction: column; }
.result-title { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 23rpx; border-bottom: 1rpx solid #f0ecef; font-size: 23rpx; font-weight: 600; }
.refresh { color: #922958; font-weight: 500; }
.hint { background: #fff9ed; color: #987232; padding: 11rpx 23rpx; font-size: 20rpx; }
.bar-scroll { flex: 1; min-height: 0; }
.bar-row { display: flex; gap: 16rpx; align-items: center; padding: 19rpx 23rpx; border-bottom: 1rpx solid #f5f2f4; }
.bar-id { width: 49rpx; height: 49rpx; border-radius: 9rpx; background: #f6edf2; color: #922958; font-weight: 800; display: flex; align-items: center; justify-content: center; font-size: 22rpx; flex-shrink: 0; }
.bar-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.bar-name { font-size: 24rpx; font-weight: 700; }
.bar-sub { color: #827c84; font-size: 20rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.chev { font-size: 40rpx; color: #bbb3ba; }
.empty { padding: 48rpx 20rpx; color: #9b939a; text-align: center; font-size: 24rpx; }
