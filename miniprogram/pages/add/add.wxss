.add-page { padding: 30rpx 25rpx 60rpx; }
.header { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 27rpx; }.h1 { font-size: 39rpx; font-weight: 800; }.desc { font-size: 23rpx; color: #807983; line-height: 1.65; }
.search-box { display: flex; gap: 12rpx; margin-bottom: 22rpx; }.query { flex: 1; min-width: 0; background: #fff; border: 1rpx solid #ece4e8; padding: 13rpx 18rpx; height: 65rpx; border-radius: 11rpx; font-size: 26rpx; }.search-btn { background: #922958; color: #fff; margin: 0; line-height: 91rpx; font-size: 23rpx; }
.label { display: block; font-weight: 750; font-size: 27rpx; margin-bottom: 17rpx; }.hint { padding: 17rpx; font-size: 21rpx; color: #815a35; background: #fff2da; border-radius: 10rpx; margin-bottom: 18rpx; }
.results,.manual,.selection { background: #fff; padding: 25rpx; border-radius: 15rpx; margin-bottom: 22rpx; }
.candidate { padding: 18rpx 0; display: flex; gap: 16rpx; align-items: center; border-top: 1rpx solid #f3eef1; }.item-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }.name { font-size: 25rpx; font-weight: 700; }.sub { font-size: 21rpx; color: #827c82; line-height: 1.5; }.insert { margin: 0; color: #922958; background: #fff2f7; font-size: 23rpx; }
.choose { background: #fff; color: #922958; border: 1rpx solid #922958; margin: 22rpx 0 0; font-size: 25rpx; }
.entry { display: block; width: 100%; box-sizing: border-box; border: 1rpx solid #ebe4e8; padding: 22rpx 15rpx; font-size: 24rpx; border-radius: 10rpx; margin: 16rpx 0; }
.save { color: white; background: #922958; font-size: 25rpx; margin-top: 22rpx; }.footnote { font-size: 20rpx; color: #9b9299; line-height: 1.7; margin-top: 25rpx; }
