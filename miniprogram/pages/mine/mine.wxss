@import "../../styles/content.wxss";
.counts{display:flex;justify-content:space-around;gap:12rpx;padding:25rpx 8rpx;margin:0 0 16rpx;text-align:center;}.counts>view{display:flex;flex-direction:column;gap:10rpx;font-size:20rpx;color:#887969}.count{font-size:39rpx;font-weight:800;color:#82442f}.profile-item{display:flex;justify-content:space-between;gap:10rpx;align-items:center;padding:17rpx 0;border-top:1rpx solid #d8c7b5;font-size:24rpx}.profile-item>text:first-child{flex:1}.theme-row{display:flex;align-items:center;gap:16rpx;padding:20rpx 0;border-top:1rpx solid #d8c7b5;font-size:24rpx}.theme-swatch{width:35rpx;height:35rpx;border-radius:50%;flex-shrink:0}.theme-name{flex:1}.theme-noir .count{color:#e9ba79}.theme-noir .theme-row,.theme-noir .profile-item{border-color:#454149}
