.detail-page { box-sizing: border-box; min-height: 100vh; padding: 32rpx 24rpx 68rpx; }
.hero { display: flex; flex-direction: column; gap: 14rpx; padding: 14rpx 7rpx 26rpx; }
.hero-label { font-size: 18rpx; }
.hero-name { font-size: 52rpx; line-height: 1.3; }
.hero-station { font-size: 22rpx; line-height: 1.6; }
.metrics { display: flex; gap: 13rpx; margin-bottom: 22rpx; }
.metric { box-sizing: border-box; min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 13rpx; padding: 22rpx 18rpx; }
.tag { font-size: 21rpx; }
.number { font-size: 33rpx; }
.metric-note { font-size: 18rpx; line-height: 1.5; }
.section { padding: 24rpx 23rpx; }
.section-head { margin-bottom: 12rpx; display: flex; flex-direction: column; gap: 8rpx; }
.section-title { font-size: 33rpx; }
.item { display: flex; align-items: flex-start; gap: 20rpx; justify-content: space-between; border-top: 1rpx solid #d8c7b5; padding: 18rpx 0; font-size: 22rpx; line-height: 1.5; }
.item text:first-child { flex-shrink: 0; }
.item text:last-child { text-align: right; }
.address { font-size: 22rpx; padding: 13rpx 0; line-height: 1.6; }
.notice { font-size: 20rpx; border-radius: 6rpx; padding: 19rpx; line-height: 1.7; }
.buttons { display: flex; flex-direction: column; gap: 13rpx; margin-top: 25rpx; }
.buttons button { box-sizing: border-box; margin: 0; font-size: 24rpx; line-height: 84rpx; height: 86rpx; width: 100%; font-weight: 700; }
.buttons button::after { border: 0; }
.source { margin-top: 24rpx; font-size: 19rpx; line-height: 1.7; }
